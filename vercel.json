{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist-client",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/webhook/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
